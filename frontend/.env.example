# ─────────────────────────────────────────────────────────────
# Nexora Frontend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER put backend secrets (OPENAI_API_KEY, DATABASE_URL, SECRET_KEY) here.
# Vite exposes only VITE_* variables to the browser.
# ─────────────────────────────────────────────────────────────

# ── Backend API URL ───────────────────────────────────────────
# Development: http://localhost:8000
# Production:  https://your-nexora-backend.onrender.com  (or Railway/Fly URL)
VITE_API_URL=http://localhost:8000
