# ─────────────────────────────────────────────────────────────
# Nexora Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Supabase / Neon / Railway PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://nexora_user:nexora_password@localhost:5432/nexora_db

# ── JWT ───────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=supersecretkey_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development: http://localhost:5173
# Production: https://your-nexora.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AI / LLM ──────────────────────────────────────────────────
# Set to "openai" for production with real AI, "mock" for testing.
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# Required only when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key-here
